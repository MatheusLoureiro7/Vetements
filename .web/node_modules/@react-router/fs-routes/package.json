{
  "name": "@react-router/fs-routes",
  "type": "module",
  "version": "8.3.0",
  "description": "File system routing conventions for React Router, for use within routes.ts",
  "bugs": {
    "url": "https://github.com/remix-run/react-router/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/remix-run/react-router",
    "directory": "packages/react-router-fs-routes"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "wireit": {
    "build": {
      "command": "tsdown",
      "files": [
        "../../pnpm-workspace.yaml",
        "*.ts",
        "tsconfig.json",
        "package.json"
      ],
      "output": [
        "dist/**"
      ]
    }
  },
  "dependencies": {
    "minimatch": "^10.2.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "wireit": "0.14.12",
    "@react-router/dev": "8.3.0"
  },
  "peerDependencies": {
    "typescript": "^5.1.0 || ^6.0.0 || ^7.0.0",
    "@react-router/dev": "^8.3.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "files": [
    "dist/",
    "CHANGELOG.md",
    "LICENSE.md",
    "README.md"
  ],
  "scripts": {
    "build": "wireit",
    "typecheck": "tsc"
  }
}